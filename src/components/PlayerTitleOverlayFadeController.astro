---
const configuredOverlayTimeout = Number.parseInt(import.meta.env.PUBLIC_FEATURED_GAME_OVERLAY_TIMEOUT_MS ?? '3000', 10);
const overlayTimeoutMs = Number.isFinite(configuredOverlayTimeout) && configuredOverlayTimeout >= 0
  ? configuredOverlayTimeout
  : 3000;
---

<script define:vars={{ overlayTimeoutMs }}>
  const hideOverlay = (overlay) => {
    overlay.classList.add('is-faded');
    overlay.dataset.fadeScheduled = 'done';
  };

  const fadePlayerTitleOverlays = () => {
    document.querySelectorAll('[data-player-title-overlay]').forEach((overlay) => {
      if (!(overlay instanceof HTMLElement)) {
        return;
      }

      if (overlay.dataset.fadeScheduled) {
        return;
      }

      const configuredTimeout = Number.parseInt(overlay.dataset.fadeTimeoutMs ?? '', 10);
      const fadeTimeoutMs = Number.isFinite(configuredTimeout) && configuredTimeout >= 0
        ? configuredTimeout
        : overlayTimeoutMs;

      overlay.dataset.fadeScheduled = 'true';
      window.setTimeout(() => hideOverlay(overlay), fadeTimeoutMs);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', fadePlayerTitleOverlays, { once: true });
  } else {
    fadePlayerTitleOverlays();
  }

  window.addEventListener('pageshow', fadePlayerTitleOverlays);
  document.addEventListener('astro:page-load', fadePlayerTitleOverlays);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') {
      fadePlayerTitleOverlays();
    }
  });
</script>
