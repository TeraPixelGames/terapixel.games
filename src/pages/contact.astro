---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/site-links';
---

<BaseLayout title="Contact" description="Contact Terapixel Games for support, partnerships, and studio inquiries.">
  <div class="shell stack">
    <header class="page-head">
      <h1 class="page-title">Contact</h1>
      <p class="page-copy">
        Terapixel Games uses one primary inbox so players always have a clear support path and consistent response
        process.
      </p>
    </header>

    <section class="glass-panel text-panel">
      <h2>Primary Email</h2>
      <p>
        Reach us at <a href="mailto:support@terapixel.games">support@terapixel.games</a>. Include your game title and
        browser details for the fastest response. Most requests are answered within one to two business days.
      </p>
    </section>

    <section class="glass-panel text-panel">
      <h2>Routing Guide</h2>
      <ul class="product-list">
        <li>Account access: include browser and login flow details</li>
        <li>Billing: include order date and purchase email</li>
        <li>Gameplay issues: include steps to reproduce and screenshots</li>
        <li>Partnership inquiries: include your organization and proposal summary</li>
      </ul>
    </section>

    <section class="glass-panel text-panel">
      <h2>Need Faster Triage?</h2>
      <p>
        Use the <a href={withBase('/support')}>Support page</a> for account, billing, and gameplay issue templates.
      </p>
    </section>
  </div>
</BaseLayout>
