---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import games from '../data/games.json';
import type { Game } from '../types';
import { addBuildVersion, withBasePath } from '../lib/site-paths';

const gameList = games as Game[];
const playableGames = gameList.filter((game) => (game.embedUrl || game.fullScreenUrl) && !game.isComingSoon);
const buildVersion = import.meta.env.PUBLIC_TPX_BUILD_ID;
const primaryGame = playableGames[0] ?? gameList[0];
const primaryFullScreenUrl =
  primaryGame.fullScreenUrl && primaryGame.fullScreenUrl.startsWith('/')
    ? addBuildVersion(withBasePath(primaryGame.fullScreenUrl), buildVersion)
    : primaryGame.fullScreenUrl;
const genreFilters = Array.from(new Set(playableGames.map((game) => game.genre).filter(Boolean)));
---

<BaseLayout
  title="Games"
  description="Browse playable Terapixel browser games with fullscreen launch links, controls, and original player guides."
  enableAds={true}
>
  <section class="arcade-wall-hero" aria-labelledby="games-heading">
    <div class="arcade-wall-copy">
      <p class="portal-kicker">Cabinet wall</p>
      <h1 id="games-heading">Playable browser games with guides, controls, and fullscreen builds.</h1>
      <p>
        This library only lists games with working web exports. Each playable game includes launch links, guide content,
        controls, and practical notes so visitors can decide what to play before opening a fullscreen build.
      </p>
      <div class="portal-meta-row">
        <span>{playableGames.length} playable now</span>
        <span>{playableGames.length} player guides</span>
      </div>
      <div class="filter-strip" aria-label="Genre shortcuts">
        {genreFilters.map((genre) => <a href={`#${String(genre).toLowerCase().replaceAll(' ', '-')}`}>{genre}</a>)}
      </div>
    </div>

    <div class="arcade-spotlight" data-accent={primaryGame.accent ?? 'signal'}>
      <img src={withBasePath(primaryGame.image)} alt={primaryGame.title} />
      <div>
        <span>Featured live build</span>
        <strong>{primaryGame.title}</strong>
        <p>{primaryGame.seoIntro}</p>
        <div class="game-card-actions">
          {primaryFullScreenUrl && (
            <a href={primaryFullScreenUrl} target="_blank" rel="noreferrer noopener" class="btn btn-primary">
              Launch Fullscreen
            </a>
          )}
          <a href={withBasePath(`/${primaryGame.slug}`)} class="btn btn-secondary">Details</a>
        </div>
      </div>
    </div>
  </section>

  <div class="shell stack below-play">
    <section class="section-block" aria-labelledby="playable-games-heading">
      <div class="section-head split-head">
        <div>
          <p class="portal-kicker">Ready now</p>
          <h2 id="playable-games-heading" class="section-title">Playable Games</h2>
        </div>
        <p class="section-copy">Fullscreen links go directly to live web exports. Details pages include controls and strategy notes.</p>
      </div>
      <div class="game-grid arcade-grid">
        {playableGames.map((game) => (
          <div id={game.genre ? String(game.genre).toLowerCase().replaceAll(' ', '-') : undefined}>
            <GameCard game={game} playMode="fullscreen" />
          </div>
        ))}
      </div>
    </section>

    <section class="section-block" aria-labelledby="quality-heading">
      <div class="section-head">
        <p class="portal-kicker">Player-first publishing</p>
        <h2 id="quality-heading" class="section-title">What We Publish Here</h2>
      </div>
      <div class="content-grid">
        <article class="glass-panel text-panel">
          <h3>Playable Browser Builds</h3>
          <p>
            Every game listed here has an active web export, a detail page, and a fullscreen launch path. Unreleased
            work stays out of public navigation until there is something real to try.
          </p>
        </article>
        <article class="glass-panel text-panel">
          <h3>Useful Game Pages</h3>
          <p>
            Each live game page includes plain-language rules, control notes, design context, and player tips. That makes
            the page useful on its own instead of relying on an embedded frame to carry all of the value.
          </p>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>
