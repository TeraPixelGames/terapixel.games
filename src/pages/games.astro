---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import games from '../data/games.json';
import type { Game } from '../types';

const gameList = games as Game[];
const playableCount = gameList.filter((game) => (game.embedUrl || game.fullScreenUrl) && !game.isComingSoon).length;
---

<BaseLayout title="Games" description="Explore the Terapixel Games platform and play browser games instantly.">
  <div class="shell stack">
    <header class="page-head page-head-panel glass-panel">
      <h1 class="page-title">Games</h1>
      <p class="page-copy">
        A tighter library view with genre, mood, and launch state visible at a glance.
      </p>
      <div class="page-metrics" aria-label="Library summary">
        <div class="stat-pill">
          <strong>{gameList.length} titles</strong>
          <span>Across action, puzzle, and card play</span>
        </div>
        <div class="stat-pill">
          <strong>{playableCount} ready now</strong>
          <span>Instant browser launch available</span>
        </div>
        <div class="stat-pill">
          <strong>1 design language</strong>
          <span>Cleaner scanning from card to detail page</span>
        </div>
      </div>
    </header>

    <section aria-label="All games" class="section-block">
      <div class="game-grid">
        {gameList.map((game) => <GameCard game={game} playMode="fullscreen" />)}
      </div>
    </section>
  </div>
</BaseLayout>
