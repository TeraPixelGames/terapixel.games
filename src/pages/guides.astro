---
import BaseLayout from '../layouts/BaseLayout.astro';
import games from '../data/games.json';
import type { Game } from '../types';
import { withBasePath } from '../lib/site-paths';

const gameList = games as Game[];
const playableGames = gameList.filter((game) => (game.embedUrl || game.fullScreenUrl) && !game.isComingSoon);
---

<BaseLayout
  title="Tips and Controls"
  description="Read quick controls and tips for Terapixel browser games."
  enableAds={true}
>
  <div class="shell stack">
    <header class="page-head">
      <h1 class="page-title">Tips and Controls</h1>
      <p class="page-copy">
        Learn the goal, pick up the controls, and get a few practical tips before your next run. These notes are short
        on purpose so you can get back to playing.
      </p>
    </header>

    <section class="content-grid" aria-label="Playable game guide summaries">
      {
        playableGames.map((game) => (
          <article class="glass-panel text-panel">
            <p class="portal-kicker">{game.genre ?? 'Browser game'}</p>
            <h2>{game.title}</h2>
            <p>{game.seoIntro}</p>
            <p>{game.designNotes ?? game.seoDetails}</p>
            <ul class="product-list">
              {(game.playerTips ?? game.seoFeatures ?? []).slice(0, 3).map((tip) => <li>{tip}</li>)}
            </ul>
            <div class="hero-actions">
              <a href={withBasePath(`/${game.slug}`)} class="btn btn-primary">Open Game</a>
            </div>
          </article>
        ))
      }
    </section>

    <section class="section-block" aria-labelledby="practice-heading">
      <div class="section-head">
        <p class="portal-kicker">Practice</p>
        <h2 id="practice-heading" class="section-title">One Thing at a Time</h2>
      </div>
      <div class="content-grid">
        <article class="glass-panel text-panel">
          <h3>Start With One Skill</h3>
          <p>
            Pick one thing to improve before you start: smoother steering, faster color scanning, quicker card choices,
            or calmer movement under pressure. A focused retry is usually better than a random one.
          </p>
        </article>
        <article class="glass-panel text-panel">
          <h3>Use Fullscreen When It Helps</h3>
          <p>
            Fullscreen gives the game more room and makes motion easier to read. It is especially useful on smaller
            screens or when you are trying to beat a score.
          </p>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>
