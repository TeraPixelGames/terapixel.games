---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import games from '../data/games.json';
import type { Game } from '../types';
import { addBuildVersion, withBasePath } from '../lib/site-paths';

const gameList = games as Game[];
const playableGames = gameList.filter((game) => (game.embedUrl || game.fullScreenUrl) && !game.isComingSoon);
const upcomingGames = gameList.filter((game) => !((game.embedUrl || game.fullScreenUrl) && !game.isComingSoon));
const featuredGame = playableGames[0] ?? gameList[0];
const buildVersion = import.meta.env.PUBLIC_TPX_BUILD_ID;

const mapPlayableUrl = (value: string | null): string | null => {
  if (!value) return null;
  if (value.startsWith('/')) {
    const baseAwareUrl = withBasePath(value);
    return value.startsWith('/play/') ? addBuildVersion(baseAwareUrl, buildVersion) : baseAwareUrl;
  }
  return value;
};

const featuredEmbedUrl = mapPlayableUrl(featuredGame.embedUrl);
const featuredFullScreenUrl = mapPlayableUrl(featuredGame.fullScreenUrl);
const isFeaturedPortrait = featuredGame.embedOrientation === 'portrait';
---

<BaseLayout
  title="Home"
  description="Play free browser games from Terapixel Games in a fullscreen-first arcade portal."
  image={featuredGame.image}
>
  <section class="portal-hero" aria-labelledby="home-hero-title">
    <div class="portal-stage" data-accent={featuredGame.accent ?? 'signal'}>
      <div class="portal-toolbar" aria-label="Featured game controls">
        <a href={withBasePath('/games')} class="portal-brand-lockup">
          <span class="portal-led" aria-hidden="true"></span>
          <span>TeraPixel Arcade</span>
        </a>
        <nav class="portal-game-tabs" aria-label="Playable games">
          {playableGames.map((game) => (
            <a href={withBasePath(`/${game.slug}`)} class:list={['portal-tab', game.slug === featuredGame.slug && 'is-active']}>
              {game.title}
            </a>
          ))}
        </nav>
        <div class="portal-toolbar-actions">
          {featuredFullScreenUrl && (
            <a href={featuredFullScreenUrl} target="_blank" rel="noreferrer noopener" class="portal-tool-button">
              Fullscreen
            </a>
          )}
          <a href="#library" class="portal-tool-button muted">Library</a>
        </div>
      </div>

      <div class="portal-player-grid">
        <div class="portal-player-copy">
          <p class="portal-kicker">Playable now</p>
          <h1 id="home-hero-title">{featuredGame.title}</h1>
          <p>{featuredGame.seoIntro ?? 'Launch a TeraPixel browser game instantly and keep the info below the play surface.'}</p>
          <div class="portal-meta-row">
            {featuredGame.genre && <span>{featuredGame.genre}</span>}
            {featuredGame.mood && <span>{featuredGame.mood}</span>}
            <span>{playableGames.length} live builds</span>
          </div>
        </div>

        <div class:list={['portal-player-frame', isFeaturedPortrait && 'is-portrait']}>
          {
            featuredEmbedUrl ? (
              <iframe
                src={featuredEmbedUrl}
                title={`${featuredGame.title} featured game`}
                loading="eager"
                allow="fullscreen"
                allowfullscreen
              />
            ) : (
              <img src={withBasePath(featuredGame.image)} alt={featuredGame.title} />
            )
          }
        </div>
      </div>
    </div>
  </section>

  <div class="shell stack below-play">
    <section class="section-block" aria-labelledby="playable-heading">
      <div class="section-head split-head">
        <div>
          <p class="portal-kicker">Instant launch</p>
          <h2 id="playable-heading" class="section-title">Live Games</h2>
        </div>
        <p class="section-copy">A compact arcade rail for the browser-ready lineup.</p>
      </div>
      <div class="game-grid arcade-grid">
        {playableGames.map((game) => <GameCard game={game} playMode="fullscreen" />)}
      </div>
    </section>

    <section class="section-block" aria-labelledby="library">
      <div class="section-head split-head">
        <div>
          <p class="portal-kicker">The full cabinet wall</p>
          <h2 id="library" class="section-title">Game Library</h2>
        </div>
        <a href={withBasePath('/games')} class="btn btn-secondary">Open Library</a>
      </div>
      <div class="game-grid">
        {gameList.map((game) => <GameCard game={game} />)}
      </div>
    </section>

    {upcomingGames.length > 0 && (
      <section class="section-block" aria-labelledby="upcoming-heading">
        <div class="section-head">
          <p class="portal-kicker">Next cabinets</p>
          <h2 id="upcoming-heading" class="section-title">Coming Soon</h2>
        </div>
        <div class="cabinet-list">
          {upcomingGames.slice(0, 6).map((game) => (
            <a href={withBasePath(`/${game.slug}`)} class="cabinet-link">
              <strong>{game.title}</strong>
              <span>{game.genre ?? 'Browser game'} / {game.mood ?? 'In production'}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
