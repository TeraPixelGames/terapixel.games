---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Policy"
  description="Read the Terapixel Games privacy policy, including analytics, advertising, and support contact details."
>
  <div class="shell stack">
    <header class="page-head">
      <h1 class="page-title">Privacy Policy</h1>
      <p class="page-copy">Last updated: March 4, 2026</p>
    </header>

    <section class="glass-panel text-panel">
      <h2>Overview</h2>
      <p>
        This Privacy Policy explains how Terapixel Games handles data when you visit <strong>terapixel.games</strong>,
        play browser games, and contact support.
      </p>
    </section>

    <section class="glass-panel text-panel">
      <h2>Data Categories We Process</h2>
      <ul class="product-list">
        <li>Technical usage data such as browser type, device category, page path, and timestamps</li>
        <li>Diagnostics and error data used to maintain service availability</li>
        <li>Support contact data that you choose to send by email</li>
      </ul>
      <p>
        We do not require sensitive personal information to load or play publicly available games. If you contact
        support, we process only the information needed to respond to your request.
      </p>
    </section>

    <section class="glass-panel text-panel">
      <h2>Cookies, Analytics, And Advertising</h2>
      <p>
        Terapixel Games uses analytics and advertising services that may set cookies or similar identifiers to measure
        site traffic, understand gameplay page usage, and support ad delivery. These services may include Google
        Analytics and Google AdSense.
      </p>
      <p>
        Third-party providers may process data according to their own policies. You can control cookies through browser
        settings and privacy tools offered by your browser vendor.
      </p>
    </section>

    <section class="glass-panel text-panel">
      <h2>How We Use Data</h2>
      <ul class="product-list">
        <li>Operate and secure the website and game pages</li>
        <li>Diagnose errors and improve performance</li>
        <li>Respond to support requests</li>
        <li>Measure traffic and ad performance at an aggregate level</li>
      </ul>
    </section>

    <section class="glass-panel text-panel">
      <h2>Data Retention</h2>
      <p>
        We retain support communications and operational logs only as long as needed for support, compliance, and
        service reliability purposes. Retention windows may vary by provider.
      </p>
    </section>

    <section class="glass-panel text-panel">
      <h2>Third-Party Services</h2>
      <p>
        Some game experiences are embedded or linked from third-party hosting platforms. When you interact with those
        services, their privacy terms and policies apply in addition to this policy.
      </p>
    </section>

    <section class="glass-panel text-panel">
      <h2>Your Choices</h2>
      <p>
        You may request removal of support emails you sent to us, subject to legal and security obligations. You may
        also control cookies through your browser configuration.
      </p>
    </section>

    <section class="glass-panel text-panel">
      <h2>Children's Privacy</h2>
      <p>
        This site is intended for a general audience and is not directed to children under 13. We do not knowingly
        collect personal information from children under 13.
      </p>
    </section>

    <section class="glass-panel text-panel">
      <h2>Policy Updates</h2>
      <p>
        We may update this policy as the platform evolves. Updated versions are published on this page with a revised
        effective date.
      </p>
    </section>

    <section class="glass-panel text-panel">
      <h2>Privacy Contact</h2>
      <p>
        For privacy questions or requests, email
        <a href="mailto:support@terapixel.games">support@terapixel.games</a> with "Privacy Request" in the subject
        line.
      </p>
    </section>
  </div>
</BaseLayout>
