---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Support" description="Get support for Terapixel Games account, shop, and gameplay questions.">
  <div class="shell stack">
    <header class="page-head">
      <h1 class="page-title">Support</h1>
      <p class="page-copy">
        Contact us through one channel and we route your request by issue type. Typical response time is one to two
        business days.
      </p>
    </header>

    <section class="support-grid" aria-label="Support options">
      <article class="glass-panel support-card">
        <h2>Account Support</h2>
        <p>
          Need help logging in, switching devices, or recovering access to your Terapixel identity session? Include
          your browser and the game page where login failed.
        </p>
        <div class="hero-actions">
          <button id="support-open-auth" type="button" class="btn btn-secondary">Open Account Modal</button>
        </div>
      </article>

      <article class="glass-panel support-card">
        <h2>Shop + Billing</h2>
        <p>
          Questions about support packs, charges, or receipts. Add your order date, payment provider, and the email
          used at checkout so we can resolve faster.
        </p>
        <div class="hero-actions">
          <a href="mailto:support@terapixel.games" class="btn btn-secondary">Email Billing</a>
        </div>
      </article>

      <article class="glass-panel support-card">
        <h2>Gameplay Reports</h2>
        <p>
          Report bugs, balance issues, or feature requests. Include game title, steps to reproduce, and what you
          expected versus what happened.
        </p>
        <div class="hero-actions">
          <a href="mailto:support@terapixel.games?subject=Gameplay%20Report" class="btn btn-secondary">Report Issue</a>
        </div>
      </article>
    </section>

    <section class="glass-panel text-panel" aria-labelledby="support-whattoinclude-heading">
      <h2 id="support-whattoinclude-heading">What To Include In A Support Email</h2>
      <ul class="product-list">
        <li>Issue category: account, billing, gameplay, or other</li>
        <li>Game title and page URL</li>
        <li>Device + browser version</li>
        <li>Time of issue and clear reproduction steps</li>
        <li>Screenshots or short clips when available</li>
      </ul>
    </section>

    <section class="glass-panel text-panel" aria-labelledby="support-contact-heading">
      <h2 id="support-contact-heading">Direct Contact And Escalation</h2>
      <p>
        Email <a href="mailto:support@terapixel.games">support@terapixel.games</a> and include the game title, browser,
        and a short issue summary. We triage security or billing issues first. If your request is unresolved after two
        business days, reply in the same thread with "Escalation Request" in the subject line.
      </p>
    </section>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      const openSupport = document.getElementById('support-open-auth');
      if (!openSupport) {
        return;
      }

      openSupport.addEventListener('click', function () {
        const globalOpen = document.getElementById('tpx-auth-open');
        if (globalOpen instanceof HTMLElement) {
          globalOpen.click();
        }
      });
    });
  </script>
</BaseLayout>
