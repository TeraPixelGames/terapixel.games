---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/site-links';
---

<BaseLayout
  title="Terms"
  description="Read the Terapixel Games terms of use for access, acceptable use, and service expectations."
>
  <div class="shell stack">
    <header class="page-head">
      <h1 class="page-title">Terms of Use</h1>
      <p class="page-copy">Last updated: March 4, 2026</p>
    </header>

    <section class="glass-panel text-panel">
      <h2>Acceptance Of Terms</h2>
      <p>
        By accessing terapixel.games, you agree to these Terms of Use and our
        <a href={withBase('/privacy-policy')}>Privacy Policy</a>. If you do not agree, do not use the site.
      </p>
    </section>

    <section class="glass-panel text-panel">
      <h2>Service Description</h2>
      <p>
        Terapixel Games provides browser-based game pages, account features, and support resources. Features may change
        as games are updated or replaced.
      </p>
    </section>

    <section class="glass-panel text-panel">
      <h2>Acceptable Use</h2>
      <ul class="product-list">
        <li>Do not disrupt service availability, security, or other players' access</li>
        <li>Do not reverse engineer, scrape, or automate abuse against the site or game endpoints</li>
        <li>Do not post unlawful, harmful, or fraudulent content through support or account features</li>
      </ul>
    </section>

    <section class="glass-panel text-panel">
      <h2>Intellectual Property</h2>
      <p>
        Game art, code, branding, and editorial content on this site are protected by applicable intellectual property
        laws. Use outside normal gameplay requires written permission.
      </p>
    </section>

    <section class="glass-panel text-panel">
      <h2>Availability And Changes</h2>
      <p>
        We aim to keep game pages available, but uptime is not guaranteed. We may update, pause, or remove features at
        any time to improve quality, reliability, or compliance.
      </p>
    </section>

    <section class="glass-panel text-panel">
      <h2>Disclaimers And Liability</h2>
      <p>
        Services are provided on an "as is" basis without warranties of uninterrupted availability. To the extent
        allowed by law, Terapixel Games is not liable for indirect or consequential damages from use of the site.
      </p>
    </section>

    <section class="glass-panel text-panel">
      <h2>Contact</h2>
      <p>
        Questions about these terms can be sent to
        <a href="mailto:support@terapixel.games">support@terapixel.games</a>.
      </p>
    </section>
  </div>
</BaseLayout>
